{
  "name": "iap-promo",
  "version": "0.1.0",
  "description": "Generate App Store-compliant promoted In-App Purchase images (1024x1024, original art — not screenshots). Avoids Apple Guideline 2.3.2 rejections.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "iap-promo": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "app-store",
    "app-store-connect",
    "in-app-purchase",
    "iap",
    "promoted-iap",
    "promotional-image",
    "guideline-2.3.2",
    "aso",
    "expo",
    "react-native"
  ],
  "author": "Filipe Ferreira",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coding-spot-com/iap-promo.git"
  },
  "bugs": {
    "url": "https://github.com/coding-spot-com/iap-promo/issues"
  },
  "homepage": "https://github.com/coding-spot-com/iap-promo#readme",
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "sharp": "^0.34.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^22.7.0",
    "eslint": "^9.13.0",
    "prettier": "^3.3.3",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.10.0",
    "vitest": "^2.1.0"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  }
}
